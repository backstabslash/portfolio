---
import { Image } from 'astro:assets';
import config from '../../site.config';
import { resolveImage } from '../lib/images';

async function fetchStars(githubUrl: string): Promise<number | null> {
  const match = githubUrl.match(/github\.com\/([^/]+)\/([^/]+)/);
  if (!match) return null;
  const [, owner, repo] = match;
  try {
    const res = await fetch(`https://api.github.com/repos/${owner}/${repo.replace(/\.git$/, '')}`, {
      headers: { 'User-Agent': 'portfolio-build', Accept: 'application/vnd.github+json' },
    });
    if (!res.ok) return null;
    const data = (await res.json()) as { stargazers_count?: number };
    return typeof data.stargazers_count === 'number' ? data.stargazers_count : null;
  } catch {
    return null;
  }
}

const teaser = config.projectTeaser;

const projects = await Promise.all(
  config.projects.map(async (project) => {
    if (!project.liveStars) return project;
    const live = await fetchStars(project.github);
    return live !== null ? { ...project, stars: live } : project;
  }),
);
---

<section id="projects">
  <h2 class="section-label"><span>[</span> Projects <span>]</span></h2>
  <div class="projects-grid">
    {
      projects.map((project) => (
        <a
          href={project.url ?? project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card"
        >
          <div class="project-image">
            <Image
              class:list={{ 'shot-dark': project.imageLight }}
              src={resolveImage(project.image)}
              alt={project.title}
              widths={[524, 1048]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="sync"
            />
            {project.imageLight && (
              <Image
                class="shot-light"
                src={resolveImage(project.imageLight)}
                alt={project.title}
                widths={[524, 1048]}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="sync"
              />
            )}
          </div>
          <div class="project-body">
            <div class="project-meta">
              {project.label && <span>{project.label}</span>}
              {!!project.stars && <span>{project.stars} stars</span>}
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="project-tech">
              {project.tech.map((t) => (
                <span>{t}</span>
              ))}
            </div>
            <div class="project-link">
              <span>-&gt; {project.url ? 'Live' : 'GitHub'}</span>
            </div>
          </div>
        </a>
      ))
    }
    {
      teaser && (
        <a
          href={teaser.github}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card project-teaser"
        >
          <div class="project-image teaser-terminal" aria-hidden="true">
            <code>
              <span class="teaser-prompt">~ ❯</span> {teaser.prompt}
              <br />
              <span class="teaser-output">{teaser.output}</span>
              <br />
              <span class="teaser-prompt">~ ❯</span>
              <span class="teaser-cursor" />
            </code>
          </div>
          <div class="project-body">
            <div class="project-meta">
              <span>{teaser.label}</span>
            </div>
            <h3>{teaser.title}</h3>
            <p>{teaser.description}</p>
            <div class="project-tech">
              {teaser.tech.map((t) => (
                <span>{t}</span>
              ))}
            </div>
            <div class="project-link">
              <span>-&gt; GitHub</span>
            </div>
          </div>
        </a>
      )
    }
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 24px;
  }

  .project-card {
    background: var(--card);
    border: 1px solid var(--border);
    transition:
      background 0.25s,
      border-color 0.25s,
      transform 0.25s;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    background: var(--card-hover);
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-teaser {
    border-style: dashed;
  }

  .teaser-terminal {
    padding: 20px 24px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-secondary);
  }

  .teaser-terminal code {
    line-height: 1.8;
  }

  .teaser-prompt {
    color: var(--accent);
  }

  .teaser-output {
    color: var(--text-tertiary);
  }

  .teaser-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: teaser-blink 1.1s steps(1) infinite;
  }

  @keyframes teaser-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser-cursor {
      animation: none;
    }
  }

  .project-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
  }

  .project-card h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .project-card p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
    min-height: 3.3em;
    margin-bottom: 16px;
    text-align: justify;
    -webkit-hyphens: auto;
    hyphens: auto;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .project-tech span {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 10px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-tertiary);
    transition: color 0.2s;
    margin-top: auto;
  }

  .project-card:hover .project-link {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .project-image .shot-light {
    position: absolute;
    inset: 0;
  }

  [data-theme='dark'] .project-image .shot-light,
  [data-theme='light'] .project-image .shot-dark {
    visibility: hidden;
  }
</style>
