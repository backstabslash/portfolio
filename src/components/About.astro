---
import { Image } from 'astro:assets';
import config from '../../site.config';
import { resolveImage } from '../lib/images';

const paragraphs = config.about.text.split('\n\n');
---

<section id="about">
  <h2 class="section-label"><span>[</span> About <span>]</span></h2>
  <div class="about-grid">
    <div class="about-image">
      <Image
        src={resolveImage(config.about.image)}
        alt={`${config.name} at work`}
        widths={[432, 864]}
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </div>
    <div class="about-text">
      {paragraphs.map((p) => <p>{p}</p>)}
      <dl class="skills">
        {
          config.skills.map((skill) => (
            <div class="skill-row">
              <dt>{skill.label}</dt>
              <dd>
                {skill.items.split(', ').map((item) => (
                  <span>{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: 64px;
    align-items: center;
  }

  .about-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .about-text p {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 16px;
  }

  .skills {
    display: grid;
    gap: 14px;
    margin-top: 32px;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    align-items: baseline;
  }

  .skill-row dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skill-row dd {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .skill-row span + span::before {
    content: '/';
    margin: 0 10px;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .skills {
      gap: 20px;
    }

    .skill-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
